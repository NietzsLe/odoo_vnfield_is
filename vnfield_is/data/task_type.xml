<odoo>
    <data noupdate="1">

        <record id="work_type_foundation_excavation" model="vnfield.task.type">
            <field name="name">Đào móng</field>
            <field name="description">Đào đất, tạo hình hố móng cho công trình.</field>
        </record>

        <record id="work_type_pile_pressing" model="vnfield.task.type">
            <field name="name">Ép cọc</field>
            <field name="description">Thi công nền móng bằng cọc ép.</field>
        </record>

        <record id="work_type_rebar_work" model="vnfield.task.type">
            <field name="name">Làm cốt thép</field>
            <field name="description">Lắp đặt, buộc cốt thép cho sàn, cột, dầm.</field>
        </record>

        <record id="work_type_concreting" model="vnfield.task.type">
            <field name="name">Đổ bê tông</field>
            <field name="description">Đổ bê tông cho sàn, cột, dầm, móng.</field>
        </record>

        <record id="work_type_wall_building" model="vnfield.task.type">
            <field name="name">Xây tường</field>
            <field name="description">Xây tường gạch, tường bao, tường ngăn trong công trình.</field>
        </record>

        <record id="work_type_electrical_installation" model="vnfield.task.type">
            <field name="name">Lắp đặt điện</field>
            <field name="description">Thi công hệ thống điện: dây dẫn, tủ điện, thiết bị chiếu sáng.</field>
        </record>

        <record id="work_type_water_installation" model="vnfield.task.type">
            <field name="name">Lắp đặt nước</field>
            <field name="description">Thi công hệ thống cấp, thoát nước và thiết bị vệ sinh.</field>
        </record>

        <record id="work_type_paint_finish" model="vnfield.task.type">
            <field name="name">Sơn bả hoàn thiện</field>
            <field name="description">Bả, lăn sơn hoàn thiện tường, trần nhà.</field>
        </record>

        <record id="work_type_waterproofing" model="vnfield.task.type">
            <field name="name">Chống thấm</field>
            <field name="description">Xử lý chống thấm tầng hầm, sàn mái, nhà vệ sinh.</field>
        </record>

        <record id="work_type_scaffolding" model="vnfield.task.type">
            <field name="name">Lắp dựng giàn giáo</field>
            <field name="description">Dựng giàn giáo phục vụ thi công các khu vực cao.</field>
        </record>

        <record id="work_type_roofing" model="vnfield.task.type">
            <field name="name">Thi công mái</field>
            <field name="description">Lắp đặt mái ngói, mái tôn hoặc mái bê tông.</field>
        </record>

        <record id="work_type_tile_work" model="vnfield.task.type">
            <field name="name">Lát gạch</field>
            <field name="description">Lát sàn, ốp tường bằng gạch men, gạch đá.</field>
        </record>

        <record id="work_type_door_installation" model="vnfield.task.type">
            <field name="name">Lắp cửa</field>
            <field name="description">Thi công lắp đặt cửa đi, cửa sổ: nhôm kính, gỗ, thép.</field>
        </record>

        <record id="work_type_aircon_installation" model="vnfield.task.type">
            <field name="name">Lắp điều hòa</field>
            <field name="description">Thi công hệ thống điều hòa không khí.</field>
        </record>

        <record id="work_type_site_cleaning" model="vnfield.task.type">
            <field name="name">Dọn dẹp công trình</field>
            <field name="description">Vệ sinh công trường sau thi công, chuẩn bị bàn giao.</field>
        </record>

    </data>
</odoo>