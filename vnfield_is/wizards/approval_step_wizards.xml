<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_review_form_view" model="ir.ui.view">
        <field name="name">approval.review.view</field>
        <field name="model">vnfield.approval.review</field>
        <field name="arch" type="xml">
            <form string="Review">
                <group>
                    <field name="result" />
                    <field name="comment" />
                    <field name="attachment_ids" widget="many2many_binary" />
                </group>
                <footer>
                    <button string="Confirm" name="handle_confirm" type="object" default_focus="1"
                        class="btn-primary" />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>