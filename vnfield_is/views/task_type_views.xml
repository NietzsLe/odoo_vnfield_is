<odoo>
    <record id="task_type_tree_view" model="ir.ui.view">
        <field name="name">task.type.tree</field>
        <field name="model">vnfield.task.type</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="id" />
                <field name="name" />
                <field name="description" />
            </tree>
        </field>
    </record>
    <record id="task_type_form_view" model="ir.ui.view">
        <field name="name">task.type.form</field>
        <field name="model">vnfield.task.type</field>
        <field name="arch" type="xml">
            <form>
                <field name="id" />
                <field name="name" />
                <field name="description" />
            </form>
        </field>
    </record>
</odoo>