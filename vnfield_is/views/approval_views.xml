<odoo>
    <record id="approval_kanban_action_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">kanban</field>
        <field name="act_window_id" ref="vnfield_approval_action" />
    </record>
    <record model="ir.ui.view" id="approval_tree_view">
        <field name="name">approval.tree</field>
        <field name="model">vnfield.approval</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="id" readonly="status != 'draft'and status" />
                <field name="name" readonly="status != 'draft'and status" />
                <field name="approval_period" readonly="status != 'draft'and status" />
                <field name="status" readonly="status != 'draft'and status" />
                <field name="request_at" />
                <field name="requester_id" />
                <field name="priority" readonly="status != 'draft'and status" />
            </tree>
        </field>
    </record>
    <record model="ir.ui.view" id="approval_form_view">
        <field name="name">approval.form</field>
        <field name="model">vnfield.approval</field>
        <field name="arch" type="xml">
            <form>
                <div class="mb-2">
                    <button invisible="status != 'draft'" name="handle_send" type="object"
                        string="Send request"
                        class="btn-primary" />
                </div>
                <sheet>
                    <group>
                        <group>
                            <field name="id" />
                            <field name="name" readonly="status != 'draft'and status" />
                            <field name="description" readonly="status != 'draft'and status" />
                            <field name="requester_id" />
                        </group>
                        <group>
                            <field name="approval_period" readonly="status != 'draft'and status" />
                            <field name="status" />
                            <field name="request_at" />
                            <field name="priority" readonly="status != 'draft'and status" />
                        </group>
                    </group>
                    <group>
                        <field name="root_step_ids" readonly="status != 'draft'and status" />
                        <field name="processing_step_ids" readonly="True" />
                        <field name="approval_step_ids" />
                    </group>

                    <!-- <field name="verify_for_task_id" /> -->
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" options="{'post_refresh':True}"
                        groups="base.group_user" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
    <record model="ir.ui.view" id="approval_kanban_view">
        <field name="name">approval.kanban</field>
        <field name="model">vnfield.approval</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_content  oe_kanban_global_click">
                            <div class="d-flex flex-row gap-1">
                                <div class="">
                                    <field name="id" />
                                </div>
                                <div>
                                    <field name="name" />
                                </div>
                            </div>
                            <div>
                                <field name="status" />
                            </div>
                            <div>
                                <field name="priority" />
                            </div>
                            <div>
                                <field name="request_at" />
                            </div>
                            <div>
                                <field name="approval_period" />
                            </div>
                            <div>
                                <field name="requester_id" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>